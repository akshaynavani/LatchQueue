# latchqueue_server configuration (CLI flags override these).
LQ_TCP_HOST=0.0.0.0
LQ_TCP_PORT=7400
LQ_GRPC_ADDRESS=0.0.0.0:7401
LQ_GRPC_ENABLED=1
LQ_IO_THREADS=2
LQ_PUMP_THREADS=1
LQ_QUEUE_CAPACITY=65536
LQ_MAX_TOPICS=4096
LQ_STATS_INTERVAL=10
# Comma-separated topics created at startup
LQ_TOPICS=orders,ticks

# lq_cli
LQ_HOST=127.0.0.1
